REM ===== PUERTA D - Backtest - ProBacktest - v3 (10-nov-2026) =====
REM v3: numeracion de salidas unificada con A, B y C (1 dias, 2 EMA20,
REM     3 linea ATR diaria, 4 EMA50). Salida por defecto = 4, emaSube = 0.
REM     La salida semanal x2 antigua se elimina.
REM v2: filtro semanal REAL con TIMEFRAME(weekly), igual que el scanner v1.3
REM     (ultima semana cerrada). Interruptor emaSube (EMA50 subiendo).
REM     Salidas a elegir con "salida". Modo acciones con esETF = 0.
REM v1: filtro aproximado MM250 diaria, salida fija a 20 sesiones.
REM Senal: igual que el scanner puerta D v1.3 (solo EMA50, ventana 3).
REM Entrada: compra a la apertura del dia siguiente a la senal.
REM Uso: grafico DIARIO, un ticker cada vez, periodo lo mas largo posible.

DEFPARAM CumulateOrders = False

REM --- PARAMETROS (cambia solo estos numeros) ---
REM esETF: 1 = ETF (solo MM50 semanal) / 0 = accion (ademas, sobre el muro)
esETF = 1
REM emaSube: 1 = exige EMA50 subiendo (hoy > hace 5 sesiones) / 0 = no
emaSube = 0
REM salida: 1 = a las "dias" sesiones
REM         2 = vela entera por debajo de la EMA20 (maximo < EMA20)
REM         3 = cierre por debajo de la linea ATR diaria
REM         4 = vela entera por debajo de la EMA50
salida = 4
dias = 20
atrPer = 14
multW = 1.5
mmPer = 50
emaPer = 50
emaCorta = 20
IF esETF = 1 THEN
   multD = 2.5
ELSE
   multD = 2.0
ENDIF
cruceLook = 3

REM --- BLOQUE SEMANAL ---
TIMEFRAME(weekly)
mm50s = Average[mmPer](close)
atrW = AverageTrueRange[atrPer](close)
REM Linea Vervoort x1.5 (muro, filtro de acciones)
IF lineA[1] = 0 THEN
   lineA = close
ELSIF close > lineA[1] AND close[1] > lineA[1] THEN
   lineA = MAX(lineA[1], close - multW * atrW)
ELSIF close < lineA[1] AND close[1] < lineA[1] THEN
   lineA = MIN(lineA[1], close + multW * atrW)
ELSIF close > lineA[1] THEN
   lineA = close - multW * atrW
ELSE
   lineA = close + multW * atrW
ENDIF
REM Siempre la ultima semana CERRADA (sin mirar el futuro)
wkClose = close[1]
wkMM = mm50s[1]
wkMMprev = mm50s[2]
wkLineA = lineA[1]

REM --- BLOQUE DIARIO ---
TIMEFRAME(default)
filtroMM = wkClose > wkMM AND wkMM > wkMMprev
tendW = wkClose > wkLineA AND close > wkLineA
filtro = filtroMM AND (esETF = 1 OR tendW)

atrD = AverageTrueRange[atrPer](close)
IF lineD[1] = 0 THEN
   lineD = close
ELSIF close > lineD[1] AND close[1] > lineD[1] THEN
   lineD = MAX(lineD[1], close - multD * atrD)
ELSIF close < lineD[1] AND close[1] < lineD[1] THEN
   lineD = MIN(lineD[1], close + multD * atrD)
ELSIF close > lineD[1] THEN
   lineD = close - multD * atrD
ELSE
   lineD = close + multD * atrD
ENDIF
lvlD = lineD[1]
e20 = ExponentialAverage[emaCorta](close)
e50 = ExponentialAverage[emaPer](close)
fuerza = close > open AND close > high[1]
sube = e50 > e50[5]

IF BarIndex = 0 THEN
   d50 = 99
ENDIF
IF close CROSSES OVER e50 THEN
   d50 = 0
   hecho50 = 0
ELSE
   d50 = d50 + 1
ENDIF
ok50 = d50 < cruceLook AND hecho50 = 0 AND fuerza AND low > e50
IF ok50 THEN
   hecho50 = 1
ENDIF
senal = filtro AND ok50 AND (emaSube = 0 OR sube)

REM --- SALIDAS ---
salTiempo = (salida = 1) AND (BarIndex - TRADEINDEX(1) >= dias)
salEma20 = (salida = 2) AND (high < e20)
salLinea = (salida = 3) AND (close < lvlD)
salEma50 = (salida = 4) AND (high < e50)
salir = salTiempo OR salEma20 OR salLinea OR salEma50

REM --- ORDENES ---
IF NOT ONMARKET AND senal THEN
   BUY 1 SHARES AT MARKET
ENDIF
IF ONMARKET AND salir THEN
   SELL 1 SHARES AT MARKET
ENDIF
