REM ===== PUERTA B - Backtest - ProBacktest - v1.1 (10-nov-2026) =====
REM Senal: igual que el scanner puerta B v1.1 (giro semanal con la regla
REM        del cuerpo sobre la linea antigua, ADR-0002).
REM La senal es semanal: se compra una sola vez, a la apertura del primer
REM dia despues de cerrar la semana de la senal.
REM v1.1: numeracion de salidas unificada (sin cambios de logica).
REM Uso: grafico DIARIO, un ticker cada vez, periodo lo mas largo posible.

DEFPARAM CumulateOrders = False

REM --- PARAMETROS (cambia solo estos numeros) ---
REM esETF: 1 = ETF (linea diaria x2.5) / 0 = accion (linea diaria x2)
esETF = 1
REM salida: 1 = a las "dias" sesiones
REM         2 = vela entera por debajo de la EMA20 (maximo < EMA20)
REM         3 = cierre por debajo de la linea ATR diaria
REM         4 = vela entera por debajo de la EMA50
REM         5 = cierre semanal por debajo de la linea ATR semanal x1.5
salida = 4
dias = 20
atrPer = 14
multW = 1.5
emaPer = 20
emaLenta = 50
IF esETF = 1 THEN
   multD = 2.5
ELSE
   multD = 2.0
ENDIF

REM --- BLOQUE SEMANAL: linea Vervoort x1.5 con trinquete ---
TIMEFRAME(weekly)
atrW = AverageTrueRange[atrPer](close)
IF lineW[1] = 0 THEN
   lineW = close
ELSIF close > lineW[1] AND close[1] > lineW[1] THEN
   lineW = MAX(lineW[1], close - multW * atrW)
ELSIF close < lineW[1] AND close[1] < lineW[1] THEN
   lineW = MIN(lineW[1], close + multW * atrW)
ELSIF close > lineW[1] THEN
   lineW = close - multW * atrW
ELSE
   lineW = close + multW * atrW
ENDIF
REM Siempre la ultima semana CERRADA (sin mirar el futuro)
wkClose = close[1]
wkLine = lineW[1]
wkBodyLow = MIN(open[1], close[1])
wkPrevClose = close[2]
wkPrevLine = lineW[2]
wkOldClose = close[3]
wkOldLine = lineW[3]

REM --- BLOQUE DIARIO ---
TIMEFRAME(default)
atrD = AverageTrueRange[atrPer](close)
IF lineD[1] = 0 THEN
   lineD = close
ELSIF close > lineD[1] AND close[1] > lineD[1] THEN
   lineD = MAX(lineD[1], close - multD * atrD)
ELSIF close < lineD[1] AND close[1] < lineD[1] THEN
   lineD = MIN(lineD[1], close + multD * atrD)
ELSIF close > lineD[1] THEN
   lineD = close - multD * atrD
ELSE
   lineD = close + multD * atrD
ENDIF
lvlD = lineD[1]

e20 = ExponentialAverage[emaPer](close)
e50 = ExponentialAverage[emaLenta](close)

REM Senal semanal: dura toda la semana siguiente. Solo vale el primer dia.
senalB = wkOldClose <= wkOldLine AND wkPrevClose > wkPrevLine AND wkClose > wkLine AND wkBodyLow > wkOldLine
senal = senalB AND NOT senalB[1]

REM --- SALIDAS ---
salTiempo = (salida = 1) AND (BarIndex - TRADEINDEX(1) >= dias)
salEma20 = (salida = 2) AND (high < e20)
salLinea = (salida = 3) AND (close < lvlD)
salEma50 = (salida = 4) AND (high < e50)
salSemana = (salida = 5) AND (wkClose < wkLine)
salir = salTiempo OR salEma20 OR salLinea OR salEma50 OR salSemana

REM --- ORDENES ---
IF NOT ONMARKET AND senal THEN
   BUY 1 SHARES AT MARKET
ENDIF
IF ONMARKET AND salir THEN
   SELL 1 SHARES AT MARKET
ENDIF
