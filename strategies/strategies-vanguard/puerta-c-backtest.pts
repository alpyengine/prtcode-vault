REM ===== PUERTA C - Backtest - ProBacktest - v1 (10-nov-2026) =====
REM Senal: igual que el scanner puerta C v1.1 (rotura del maximo de 20 dias,
REM        vela entera y de fuerza, volumen sobre la media de ayer,
REM        filtro semanal).
REM Filtro semanal real con TIMEFRAME(weekly), ultima semana cerrada.
REM Entrada: compra a la apertura del dia siguiente a la senal.
REM Uso: grafico DIARIO, un ticker cada vez, periodo lo mas largo posible.

DEFPARAM CumulateOrders = False

REM --- PARAMETROS (cambia solo estos numeros) ---
REM esETF: 1 = ETF (filtro MM50 semanal, linea diaria x2.5)
REM        0 = accion (ademas, sobre el muro semanal; linea diaria x2)
esETF = 1
REM salida: 1 = a las "dias" sesiones
REM         2 = vela entera por debajo de la EMA20 (maximo < EMA20)
REM         3 = cierre por debajo de la linea ATR diaria
REM         4 = vela entera por debajo de la EMA50
salida = 3
dias = 20
atrPer = 14
multW = 1.5
mmPer = 50
emaPer = 20
emaLenta = 50
boPer = 20
volPer = 20
IF esETF = 1 THEN
   multD = 2.5
ELSE
   multD = 2.0
ENDIF

REM --- BLOQUE SEMANAL: MM50 y linea Vervoort x1.5 con trinquete ---
TIMEFRAME(weekly)
mm50s = Average[mmPer](close)
atrW = AverageTrueRange[atrPer](close)
IF lineW[1] = 0 THEN
   lineW = close
ELSIF close > lineW[1] AND close[1] > lineW[1] THEN
   lineW = MAX(lineW[1], close - multW * atrW)
ELSIF close < lineW[1] AND close[1] < lineW[1] THEN
   lineW = MIN(lineW[1], close + multW * atrW)
ELSIF close > lineW[1] THEN
   lineW = close - multW * atrW
ELSE
   lineW = close + multW * atrW
ENDIF
REM Siempre la ultima semana CERRADA (sin mirar el futuro)
wkClose = close[1]
wkMM = mm50s[1]
wkMMprev = mm50s[2]
wkLine = lineW[1]

REM --- BLOQUE DIARIO ---
TIMEFRAME(default)
atrD = AverageTrueRange[atrPer](close)
IF lineD[1] = 0 THEN
   lineD = close
ELSIF close > lineD[1] AND close[1] > lineD[1] THEN
   lineD = MAX(lineD[1], close - multD * atrD)
ELSIF close < lineD[1] AND close[1] < lineD[1] THEN
   lineD = MIN(lineD[1], close + multD * atrD)
ELSIF close > lineD[1] THEN
   lineD = close - multD * atrD
ELSE
   lineD = close + multD * atrD
ENDIF
lvlD = lineD[1]

e20 = ExponentialAverage[emaPer](close)
e50 = ExponentialAverage[emaLenta](close)

filtroMM = wkClose > wkMM AND wkMM > wkMMprev
tendW = wkClose > wkLine AND close > wkLine
filtro = filtroMM AND (esETF = 1 OR tendW)

fuerza = close > open AND close > high[1]
hiN = Highest[boPer](high)
maxPrev = hiN[1]
volAvg = Average[volPer](volume)
volPrev = volAvg[1]
senal = filtro AND fuerza AND close > maxPrev AND low > maxPrev AND volume > volPrev

REM --- SALIDAS ---
salTiempo = (salida = 1) AND (BarIndex - TRADEINDEX(1) >= dias)
salEma20 = (salida = 2) AND (high < e20)
salLinea = (salida = 3) AND (close < lvlD)
salEma50 = (salida = 4) AND (high < e50)
salir = salTiempo OR salEma20 OR salLinea OR salEma50

REM --- ORDENES ---
IF NOT ONMARKET AND senal THEN
   BUY 1 SHARES AT MARKET
ENDIF
IF ONMARKET AND salir THEN
   SELL 1 SHARES AT MARKET
ENDIF
