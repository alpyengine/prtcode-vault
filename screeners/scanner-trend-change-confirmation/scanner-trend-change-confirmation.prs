REM ============================================================
REM SCANNER: TREND CHANGE CONFIRMATION (Nivel 2) - v1.1
REM Plataforma: ProRealTime - ProScreener
REM Periodo: DIARIO
REM ------------------------------------------------------------
REM v1.1:
REM  - Reducido a 3 columnas (Senal, BullSc, BearSc) por limite
REM    de columnas de la licencia.
REM  - Anadido filtro de regimen de mercado (SPY vs EMA200).
REM  - Nota de fallback para ADX segun version de PRT.
REM ------------------------------------------------------------
REM OBJETIVO:
REM Detectar cambios de tendencia con confirmacion estructural
REM y de timeframe superior. 5 capas, score 0-5 por direccion,
REM 4 fases.
REM
REM CAPAS:
REM   A2 - ADX cayendo (agotamiento)
REM   C1 - BOS (ruptura de estructura)
REM   C2 - Fallo de ruptura (failed breakout)
REM   D1 - Alineacion semanal (muro Vervoort)
REM   D2 - Pendiente EMA200
REM
REM Senal = Dir*10 + Phase
REM   Dir: 1=Bull, 2=Bear
REM   Phase: 1=Agotamiento, 2=PrimerAviso, 3=Confirmado, 4=Fallido
REM ============================================================

REM --- PARAMETROS ---
atrPer = 14
adxPer = 14
emaPer = 200
bosLook = 20
failLook = 20
adxLook = 5
adxMax = 25
emaSlopeLook = 10
multW = 1.5
minScore = 3
minPrice = 0.5
minAvgVol = 100000
useMarketFilter = 1

REM --- CALCULOS BASE ---
atrD = AverageTrueRange[atrPer](close)
ema200 = EMA[emaPer](close)
REM Si ADX da error, cambia esta linea por ADX[adxPer] o ADX(adxPer)
adxD = ADX[adxPer](close)
volAvg = Average[20](volume)

REM --- CAPA A2: ADX cayendo ---
A2 = adxD < adxD[adxLook] AND adxD < adxMax

REM --- CAPA C1: BOS ---
bullBOS = close > highest[bosLook](high[1])
bearBOS = close < lowest[bosLook](low[1])

REM --- CAPA C2: Fallo de ruptura ---
barMid = low + (high - low) * 0.5
bullFailBear = low < lowest[failLook](low[1]) AND close > open AND close > barMid
bearFailBull = high > highest[failLook](high[1]) AND close < open AND close < barMid

REM --- CAPA D1: Alineacion semanal (muro Vervoort) ---
TIMEFRAME(weekly)
atrW = AverageTrueRange[atrPer](close)
IF lineW[1] = 0 THEN
   lineW = close
ELSIF close > lineW[1] AND close[1] > lineW[1] THEN
   lineW = MAX(lineW[1], close - multW * atrW)
ELSIF close < lineW[1] AND close[1] < lineW[1] THEN
   lineW = MIN(lineW[1], close + multW * atrW)
ELSIF close > lineW[1] THEN
   lineW = close - multW * atrW
ELSE
   lineW = close + multW * atrW
ENDIF
wkBull = close > lineW AND close[1] > lineW[1]
wkBear = close < lineW AND close[1] < lineW[1]
TIMEFRAME(default)

REM --- CAPA D2: Pendiente EMA200 ---
emaRising = ema200 > ema200[emaSlopeLook]
emaFalling = ema200 < ema200[emaSlopeLook]

REM --- FILTRO DE MERCADO ---
REM Cambia SPY por IBEX35 si operas solo mercado espanol
mktClose = CLOSE(SPY)
mktEMA200 = EMA[200](mktClose)
mktBull = mktClose > mktEMA200
mktBear = mktClose < mktEMA200

condMarketBull = 1
IF useMarketFilter = 1 AND NOT mktBull THEN
   condMarketBull = 0
ENDIF
condMarketBear = 1
IF useMarketFilter = 1 AND NOT mktBear THEN
   condMarketBear = 0
ENDIF

REM --- SCORING BULL ---
bullScore = 0
IF A2 THEN
   bullScore = bullScore + 1
ENDIF
IF bullBOS THEN
   bullScore = bullScore + 1
ENDIF
IF bullFailBear THEN
   bullScore = bullScore + 1
ENDIF
IF wkBull THEN
   bullScore = bullScore + 1
ENDIF
IF emaRising THEN
   bullScore = bullScore + 1
ENDIF

REM --- SCORING BEAR ---
bearScore = 0
IF A2 THEN
   bearScore = bearScore + 1
ENDIF
IF bearBOS THEN
   bearScore = bearScore + 1
ENDIF
IF bearFailBull THEN
   bearScore = bearScore + 1
ENDIF
IF wkBear THEN
   bearScore = bearScore + 1
ENDIF
IF emaFalling THEN
   bearScore = bearScore + 1
ENDIF

REM --- DIRECCION DOMINANTE ---
Dir = 0
IF bullScore >= minScore AND bullScore > bearScore THEN
   Dir = 1
ENDIF
IF bearScore >= minScore AND bearScore > bullScore THEN
   Dir = 2
ENDIF

REM --- FASE ---
Phase = 0
IF Dir = 1 THEN
   structureBull = bullBOS OR bullFailBear
   htfBull = 0
   IF wkBull THEN
      htfBull = htfBull + 1
   ENDIF
   IF emaRising THEN
      htfBull = htfBull + 1
   ENDIF
   IF structureBull THEN
      IF htfBull >= 2 THEN
         Phase = 3
      ELSIF htfBull >= 1 THEN
         Phase = 2
      ELSE
         Phase = 4
      ENDIF
   ELSIF A2 THEN
      Phase = 1
   ENDIF
ENDIF
IF Dir = 2 THEN
   structureBear = bearBOS OR bearFailBull
   htfBear = 0
   IF wkBear THEN
      htfBear = htfBear + 1
   ENDIF
   IF emaFalling THEN
      htfBear = htfBear + 1
   ENDIF
   IF structureBear THEN
      IF htfBear >= 2 THEN
         Phase = 3
      ELSIF htfBear >= 1 THEN
         Phase = 2
      ELSE
         Phase = 4
      ENDIF
   ELSIF A2 THEN
      Phase = 1
   ENDIF
ENDIF

REM --- CODIGO COMBINADO ---
Senal = 0
IF Dir = 1 THEN
   Senal = 10 + Phase
ENDIF
IF Dir = 2 THEN
   Senal = 20 + Phase
ENDIF

REM --- STOP Y TARGET (disponibles aunque no se muestren) ---
bullStop = lowest[5](low) - atrD * 0.5
bearStop = highest[5](high) + atrD * 0.5
Stop = 0
IF Dir = 1 THEN
   Stop = bullStop
ENDIF
IF Dir = 2 THEN
   Stop = bearStop
ENDIF

Target = 0
IF Dir = 1 THEN
   Target = highest[50](high)
ENDIF
IF Dir = 2 THEN
   Target = lowest[50](low)
ENDIF

REM --- FILTROS ---
condPrice = close > minPrice
condLiq = volAvg > minAvgVol

filterBull = Dir = 1 AND condMarketBull
filterBear = Dir = 2 AND condMarketBear
anyDir = filterBull OR filterBear

REM --- SALIDA (3 columnas) ---
SCREENER[anyDir AND condPrice AND condLiq](Senal AS "Senal", bullScore AS "BullSc", bearScore AS "BearSc")

REM Alternativa 3 columnas orientada a accion (descomenta y borra la de arriba):
REM SCREENER[anyDir AND condPrice AND condLiq](Senal AS "Senal", Stop AS "Stop", Target AS "Target")