REM ============================================================
REM SCANNER ATR TRAILING - DEBUG v1 (base v1.1) - 2026-10-18
REM Muestra TODOS los tickers con valores intermedios. Solo para validacion.
REM Columnas: Senal, LineaW (muro semanal), CierreW (cierre semanal usado).
REM v1.1: calculos solo de la version 6 col comentados (PRT da error
REM       de sintaxis si una variable se calcula y no se usa).
REM Plataforma: ProRealTime - modulo ProScreener
REM Periodo de la interfaz: DIARIO. Lista: watchlist ETF o acciones.
REM Spec: docs/indicators/scanner-atr-trailing.md
REM ADR : docs/decisions/ADR-0001-scanner-atr-trailing-diseno.md
REM ------------------------------------------------------------
REM Columna Senal = codigo combinado, un digito por senal activa:
REM   1 = Giro semanal        (puerta B)
REM   2 = Pullback tendencia  (puerta A)
REM   3 = Ruptura momentum    (puerta C)
REM   4 = Perdida del muro    (salida del radar)
REM   Ejemplo: 23 = pullback + ruptura a la vez.
REM ============================================================

REM --- PARAMETROS (editar aqui) -------------------------------
REM isETF: 1 = lista de ETF (x2.5) / 0 = lista de acciones (x2.0)
isETF = 1
REM semanaCerrada: 1 = pasada del sabado / 0 = pasada entre semana
semanaCerrada = 1
atrPer = 14
multW = 1.5
multETF = 2.5
multStock = 2.0
maPer1 = 10
maPer2 = 20
boPer = 20
volPer = 20
hsPer = 252
REM [6COL] rsiPer = 14
REM [6COL] tdLook = 3

IF isETF = 1 THEN
   multD = multETF
ELSE
   multD = multStock
ENDIF

REM ============================================================
REM BLOQUE SEMANAL - linea Vervoort con trinquete
REM ============================================================
TIMEFRAME(weekly)

atrW = AverageTrueRange[atrPer](close)

IF lineW[1] = 0 THEN
   lineW = close
ELSIF close > lineW[1] AND close[1] > lineW[1] THEN
   lineW = MAX(lineW[1], close - multW * atrW)
ELSIF close < lineW[1] AND close[1] < lineW[1] THEN
   lineW = MIN(lineW[1], close + multW * atrW)
ELSIF close > lineW[1] THEN
   lineW = close - multW * atrW
ELSE
   lineW = close + multW * atrW
ENDIF

REM wo = desfase: 0 el sabado, 1 entre semana (ultima semana cerrada)
wo = 1 - semanaCerrada
wkLine = lineW[wo]
wkClose = close[wo]
wkBodyLow = MIN(open[wo], close[wo])
wkPrevClose = close[wo + 1]
wkPrevLine = lineW[wo + 1]

sig1 = wkBodyLow > wkLine AND wkPrevClose <= wkPrevLine
sig4 = wkClose < wkLine AND wkPrevClose >= wkPrevLine
wkBull = wkClose > wkLine

REM ============================================================
REM BLOQUE DIARIO
REM ============================================================
TIMEFRAME(default)

atrD = AverageTrueRange[atrPer](close)

IF lineD[1] = 0 THEN
   lineD = close
ELSIF close > lineD[1] AND close[1] > lineD[1] THEN
   lineD = MAX(lineD[1], close - multD * atrD)
ELSIF close < lineD[1] AND close[1] < lineD[1] THEN
   lineD = MIN(lineD[1], close + multD * atrD)
ELSIF close > lineD[1] THEN
   lineD = close - multD * atrD
ELSE
   lineD = close + multD * atrD
ENDIF

REM Precio sobre el muro semanal en modo soporte
aboveWall = wkBull AND close > wkLine

REM --- Senal 2: pullback en tendencia ---
ma10 = Average[maPer1](close)
ma20 = Average[maPer2](close)
nearMA10 = ABS(close - ma10) <= atrD
nearMA20 = ABS(close - ma20) <= atrD
nearLineD = ABS(close - lineD) <= atrD
sig2 = aboveWall AND (nearMA10 OR nearMA20 OR nearLineD)

REM --- TD Buy Setup 9 (solo version 6 col) ---
REM [6COL] IF close < close[4] THEN
REM [6COL]    tdCount = tdCount + 1
REM [6COL] ELSE
REM [6COL]    tdCount = 0
REM [6COL] ENDIF
REM [6COL] IF tdCount = 9 THEN
REM [6COL]    td9Bar = BarIndex
REM [6COL] ENDIF
REM [6COL] td9 = td9Bar > 0 AND (BarIndex - td9Bar) < tdLook

REM --- Senal 3: ruptura momentum ---
hiN = Highest[boPer](high)
breakout = close > hiN[1]
forceBar = close > open AND close > high[1]
volAvg = Average[volPer](volume)
volUp = volume > volAvg
sig3 = breakout AND forceBar AND volUp AND aboveWall

REM ============================================================
REM COLUMNAS DE SALIDA
REM ============================================================
hs52 = Highest[hsPer](high)
IF hs52 > 0 THEN
   distHS = (hs52 - close) / hs52
ELSE
   distHS = 0
ENDIF
stopLvl = close - multD * atrD
REM --- Solo version 6 col ---
REM [6COL] IF wkLine > 0 THEN
REM [6COL]    distWall = (close - wkLine) / wkLine
REM [6COL] ELSE
REM [6COL]    distWall = 0
REM [6COL] ENDIF
REM [6COL] rsiD = RSI[rsiPer](close)

REM Codigo combinado: un digito por senal, en orden 1-2-3-4
sigCode = 0
IF sig1 THEN
   sigCode = sigCode * 10 + 1
ENDIF
IF sig2 THEN
   sigCode = sigCode * 10 + 2
ENDIF
IF sig3 THEN
   sigCode = sigCode * 10 + 3
ENDIF
IF sig4 THEN
   sigCode = sigCode * 10 + 4
ENDIF

anySig = sigCode > 0

REM --- DEBUG: muestra todos los tickers ---
dbgAll = anySig OR distHS >= 0 OR stopLvl <> 0 OR close > 0
SCREENER[dbgAll](sigCode AS "Senal", wkLine AS "LineaW", wkClose AS "CierreW")
