REM ===== PUERTA B - Giro semanal - ProScreener - v1.1 (07-nov-2026) =====
REM v1.1: anadida la condicion de la regla D (ADR-0002): el cuerpo entero de la
REM       semana 0 (wkBodyLow) debe quedar sobre la linea ANTIGUA (semana -2).
REM       Igual que la senal 1 del scanner ATR Trailing v1.2.
REM Periodo de la interfaz: Diario. Lista: acciones (o ETF si la licencia los muestra).
REM Senal: semana -2 en la linea o debajo / semana -1 encima / semana 0 encima
REM        y cuerpo de la semana 0 sobre la linea de la semana -2.
REM Sin vela de fuerza diaria (la puerta B es solo semanal).
REM Columnas: ATR14 diario, distancia % a la linea semanal, volumen / media 20.

REM --- PARAMETROS ---
REM semanaCerrada: 1 = pasada del sabado / 0 = entre semana (ultima semana cerrada)
semanaCerrada = 0
atrPer = 14
multW = 1.5
volPer = 20

REM --- BLOQUE SEMANAL: linea Vervoort con trinquete ---
TIMEFRAME(weekly)
atrW = AverageTrueRange[atrPer](close)
IF lineW[1] = 0 THEN
   lineW = close
ELSIF close > lineW[1] AND close[1] > lineW[1] THEN
   lineW = MAX(lineW[1], close - multW * atrW)
ELSIF close < lineW[1] AND close[1] < lineW[1] THEN
   lineW = MIN(lineW[1], close + multW * atrW)
ELSIF close > lineW[1] THEN
   lineW = close - multW * atrW
ELSE
   lineW = close + multW * atrW
ENDIF
wo = 1 - semanaCerrada
wkClose = close[wo]
wkLine = lineW[wo]
wkBodyLow = MIN(open[wo], close[wo])
wkPrevClose = close[wo + 1]
wkPrevLine = lineW[wo + 1]
wkOldClose = close[wo + 2]
wkOldLine = lineW[wo + 2]

senalB = wkOldClose <= wkOldLine AND wkPrevClose > wkPrevLine AND wkClose > wkLine AND wkBodyLow > wkOldLine

REM --- BLOQUE DIARIO: columnas ---
TIMEFRAME(default)
atrD = AverageTrueRange[atrPer](close)
volAvg = Average[volPer](volume)
IF volAvg > 0 THEN
   volRel = volume / volAvg
ELSE
   volRel = 0
ENDIF
IF wkLine > 0 THEN
   distW = (close - wkLine) / wkLine
ELSE
   distW = 0
ENDIF

SCREENER[senalB](atrD AS "ATR14", distW AS "DistMuro" PERCENTFORMAT, volRel AS "VolRel")