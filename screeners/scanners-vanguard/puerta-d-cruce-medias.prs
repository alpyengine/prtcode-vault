REM ===== PUERTA D - Cruce de medias - ProScreener - v1.2 (07-nov-2026) =====
REM v1.2: el cruce ya no tiene que ser en la misma vela que la vela entera.
REM       Ventana de cruceLook sesiones: el cierre cruzo al alza la EMA20 (o la
REM       EMA50) hoy o en las 2 sesiones anteriores. Hoy: vela de fuerza y vela
REM       entera sobre esa media. Solo la primera vela que lo cumple tras el
REM       cruce (sin repetir). Columna DiasCruce preparada para 6 columnas.
REM v1.1: vela entera sobre la media cruzada; quitada la rama "conf";
REM       filtro semanal sobre la ultima semana cerrada; modo acciones.
REM Periodo de la interfaz: Diario.
REM Lista ETF (esETF = 1): VGT VFH VAW VXUS VYM VHT VDC SCHD VIG VTV
REM Lista acciones en prueba (esETF = 0).
REM Filtro: cierre semanal sobre la MM50 semanal y la MM50 subiendo.
REM         Acciones: ademas, cierre semanal sobre la linea ATR semanal x1.5.
REM Columnas: ATR14 diario, distancia % a la linea semanal, volumen / media 20.

REM --- PARAMETROS ---
REM esETF: 1 = lista de ETF / 0 = lista de acciones
esETF = 1
REM semanaCerrada: 1 = pasada del sabado / 0 = entre semana (ultima semana cerrada)
semanaCerrada = 0
atrPer = 14
multW = 1.5
mmPer = 50
volPer = 20
REM cruceLook: sesiones de la ventana (3 = hoy y las 2 anteriores)
cruceLook = 3

REM --- BLOQUE SEMANAL: MM50 y linea Vervoort con trinquete ---
TIMEFRAME(weekly)
mm50s = Average[mmPer](close)
atrW = AverageTrueRange[atrPer](close)
IF lineW[1] = 0 THEN
   lineW = close
ELSIF close > lineW[1] AND close[1] > lineW[1] THEN
   lineW = MAX(lineW[1], close - multW * atrW)
ELSIF close < lineW[1] AND close[1] < lineW[1] THEN
   lineW = MIN(lineW[1], close + multW * atrW)
ELSIF close > lineW[1] THEN
   lineW = close - multW * atrW
ELSE
   lineW = close + multW * atrW
ENDIF
wo = 1 - semanaCerrada
wkClose = close[wo]
wkLine = lineW[wo]
filtroMM = wkClose > mm50s[wo] AND mm50s[wo] > mm50s[wo + 1]

REM --- BLOQUE DIARIO ---
TIMEFRAME(default)
atrD = AverageTrueRange[atrPer](close)
tendW = wkClose > wkLine AND close > wkLine
filtro = filtroMM AND (esETF = 1 OR tendW)

e20 = ExponentialAverage[20](close)
e50 = ExponentialAverage[50](close)
fuerza = close > open AND close > high[1]

REM Sesiones desde el ultimo cruce al alza (d = 0 el dia del cruce).
REM hecho = 1 cuando ya se dio la senal tras ese cruce (no repetir).
IF BarIndex = 0 THEN
   d20 = 99
   d50 = 99
ENDIF
IF close CROSSES OVER e20 THEN
   d20 = 0
   hecho20 = 0
ELSE
   d20 = d20 + 1
ENDIF
IF close CROSSES OVER e50 THEN
   d50 = 0
   hecho50 = 0
ELSE
   d50 = d50 + 1
ENDIF

REM Vela entera sobre la media (low > media) implica cierre sobre la media.
ok20 = d20 < cruceLook AND hecho20 = 0 AND fuerza AND low > e20
ok50 = d50 < cruceLook AND hecho50 = 0 AND fuerza AND low > e50
IF ok20 THEN
   hecho20 = 1
ENDIF
IF ok50 THEN
   hecho50 = 1
ENDIF

senalD = filtro AND (ok20 OR ok50)

REM --- COLUMNAS ---
volAvg = Average[volPer](volume)
IF volAvg > 0 THEN
   volRel = volume / volAvg
ELSE
   volRel = 0
ENDIF
IF wkLine > 0 THEN
   distW = (close - wkLine) / wkLine
ELSE
   distW = 0
ENDIF
REM --- Solo version 6 columnas ---
REM [6COL] IF ok20 THEN
REM [6COL]    diasC = d20
REM [6COL] ELSE
REM [6COL]    diasC = d50
REM [6COL] ENDIF

REM --- Version 3 columnas (licencia gratuita) ---
SCREENER[senalD](atrD AS "ATR14", distW AS "DistMuro" PERCENTFORMAT, volRel AS "VolRel")

REM --- Version 6 columnas ---
REM Para activarla: quita "REM [6COL] " de las lineas marcadas, borra la linea
REM SCREENER de arriba y quita el REM de la linea de abajo.
REM SCREENER[senalD](atrD AS "ATR14", distW AS "DistMuro" PERCENTFORMAT, volRel AS "VolRel", diasC AS "DiasCruce")
