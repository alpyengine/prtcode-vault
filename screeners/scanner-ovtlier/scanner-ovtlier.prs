REM ═══════════════════════════════════════════════════════════
REM  OUTLIER SCREENER v4 — ProRealTime ProScreener
REM  Mejoras y correcciones vs v3:
REM    - Umbral de volumen corregido a 500.000 acciones medias 20d
REM    - Nuevo filtro de liquidez monetaria: dollar volume > 5M
REM    - AverageTrueRange[14] corregido con parametro (Close)
REM    - Renombrada "RS 20d %" a "Ret 20d %" (no era fuerza relativa
REM      real, era retorno absoluto del activo)
REM    - Eliminado bloque inerte valSPY = 1 heredado de v2
REM  Condiciones:
REM    1. Tendencia corto : EMA10 > EMA20 y Close > EMA50
REM    2. Tendencia largo : Close > EMA200
REM    3. Momentum RSI    : RSI(14) > 58
REM    4. Precio minimo   : Close > 10
REM    5. Volumen         : Media 20d > 500.000 acciones
REM    6. Liquidez $      : Dollar volume medio 20d > 5.000.000
REM    7. Momentum precio : Close > Close[5]
REM  Columnas (orden = Mom 5d % de mayor a menor):
REM    Mom 5d %   — rendimiento 5 dias
REM    RSI        — RSI actual
REM    Ret 20d %  — retorno de 20 dias
REM    ATR %      — volatilidad ATR normalizada
REM    Vol Ratio  — volumen vs media 20d
REM    Dist EMA50 — distancia % al EMA50
REM ═══════════════════════════════════════════════════════════

TIMEFRAME(daily)

REM ── Medias moviles ──────────────────────────────────────────
val10  = ExponentialAverage[10](Close)
val20  = ExponentialAverage[20](Close)
val50  = ExponentialAverage[50](Close)
val200 = ExponentialAverage[200](Close)

REM ── RSI ─────────────────────────────────────────────────────
valRSI = RSI[14](Close)

REM ── Liquidez ───────────────────────────────────────────────
REM    valVolMA     : media de volumen en acciones (20d)
REM    valDollarVol : liquidez monetaria media (volumen x precio)
REM    Ambas se usan como filtros; el ratio es solo informativo
valVolMA     = Average[20](Volume)
valVolRatio  = Volume / valVolMA
valDollarVol = valVolMA * Close

REM ── Rendimientos, distancias y volatilidad ──────────────────
valMom5    = (Close - Close[5])  / Close[5]  * 100
valRet20   = (Close - Close[20]) / Close[20] * 100
valATR     = AverageTrueRange[14](Close)
valATRpct  = valATR / Close * 100
valDistEMA = (Close - val50) / val50 * 100

REM ── Condiciones ────────────────────────────────────────────
filtTrend    = val10 > val20 AND Close > val50
filtTrend200 = Close > val200
filtMoment   = valRSI > 58
filtPrice    = Close > 10
filtVol      = valVolMA > 500000
filtDollar   = valDollarVol > 5000000
filtMom5     = Close > Close[5]

filtAll = filtTrend AND filtTrend200 AND filtMoment AND filtPrice AND filtVol AND filtDollar AND filtMom5

SCREENER[filtAll](valMom5 AS "Mom 5d %", valRSI AS "RSI", valRet20 AS "Ret 20d %", valATRpct AS "ATR %", valVolRatio AS "Vol Ratio", valDistEMA AS "Dist EMA50 %")
