REM ═══════════════════════════════════════════════════════════
REM  OUTLIER SCREENER v5 — ProRealTime ProScreener
REM  Version vigente. Evolucion de v4 con 3 filtros de calidad:
REM    + ADX(14) > 20           — tendencia con fuerza real
REM    + EMA50 con pendiente >0 — tendencia no plana
REM    + Dist EMA50 < 20%       — evitar sobre-extension
REM  Mantiene de v4:
REM    - EMA10>EMA20 y Close>EMA50 y Close>EMA200
REM    - RSI(14) > 58
REM    - Close > 10
REM    - VolumeMA20 > 500.000 y DollarVol > 5M
REM    - Close > Close[5]
REM  Columnas (orden = Mom 5d % de mayor a menor):
REM    Mom 5d %   — rendimiento 5 dias
REM    RSI        — RSI actual
REM    ADX        — fuerza de tendencia (14)
REM    Ret 20d %  — retorno de 20 dias
REM    ATR %      — volatilidad ATR normalizada
REM    Vol Ratio  — volumen vs media 20d
REM    Dist EMA50 — distancia % al EMA50
REM ═══════════════════════════════════════════════════════════

TIMEFRAME(daily)

REM ── Medias moviles ──────────────────────────────────────────
val10  = ExponentialAverage[10](Close)
val20  = ExponentialAverage[20](Close)
val50  = ExponentialAverage[50](Close)
val200 = ExponentialAverage[200](Close)

REM ── Momentum, volatilidad y fuerza de tendencia ────────────
valRSI = RSI[14](Close)
valADX = ADX[14]
valATR = AverageTrueRange[14](Close)

REM ── Liquidez ───────────────────────────────────────────────
valVolMA     = Average[20](Volume)
valVolRatio  = Volume / valVolMA
valDollarVol = valVolMA * Close

REM ── Rendimientos, distancias y pendiente ───────────────────
valMom5    = (Close - Close[5])  / Close[5]  * 100
valRet20   = (Close - Close[20]) / Close[20] * 100
valATRpct  = valATR / Close * 100
valDistEMA = (Close - val50) / val50 * 100
valSlope50 = (val50 - val50[5]) / val50[5] * 100

REM ── Condiciones ────────────────────────────────────────────
filtTrend    = val10 > val20 AND Close > val50
filtTrend200 = Close > val200
filtSlope    = valSlope50 > 0
filtQuality  = valADX > 20
filtMoment   = valRSI > 58
filtPrice    = Close > 10
filtVol      = valVolMA > 500000
filtDollar   = valDollarVol > 5000000
filtMom5     = Close > Close[5]
filtNotOver  = valDistEMA < 20

filtAll = filtTrend AND filtTrend200 AND filtSlope AND filtQuality AND filtMoment AND filtPrice AND filtVol AND filtDollar AND filtMom5 AND filtNotOver

SCREENER[filtAll](valMom5 AS "Mom 5d %", valRSI AS "RSI", valADX AS "ADX", valRet20 AS "Ret 20d %", valATRpct AS "ATR %", valVolRatio AS "Vol Ratio", valDistEMA AS "Dist EMA50 %")
